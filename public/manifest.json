{
  "manifest_version": 3,
  "name": "DeepSeek Export Plus · 网页对话导出",
  "version": "2.1.2",
  "minimum_chrome_version": "120",
  "description": "选择轮次导出DeepSeek chat/share对话、思考、搜索记录、图片与附件，支持Markdown、ZIP和PDF预览。",
  "permissions": ["clipboardWrite", "storage", "scripting"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://files.deepseeksvc.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content/historyBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content/index.js"],
      "css": ["content/style.css"]
    }
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "icons": {
    "16": "icons/fish-16.png",
    "32": "icons/fish-32.png",
    "48": "icons/fish-48.png",
    "128": "icons/fish-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/fish-48.png", "icons/fish-128.png"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ]
}
