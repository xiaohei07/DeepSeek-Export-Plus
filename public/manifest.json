{
  "manifest_version": 3,
  "name": "DeepSeek Export Plus · 网页对话导出",
  "version": "2.3.0",
  "options_page": "privacy/index.html",
  "minimum_chrome_version": "120",
  "description": "按轮次保存DeepSeek chat/share对话，支持Markdown、HTML、TXT、JSON、Word、PNG及多格式ZIP，可选思考、工具记录、图片与附件。",
  "permissions": [
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://files.deepseeksvc.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content/index.js"
      ],
      "css": [
        "content/style.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "icons": {
    "16": "icons/fish-16.png",
    "32": "icons/fish-32.png",
    "48": "icons/fish-48.png",
    "128": "icons/fish-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/fish-48.png",
        "icons/fish-128.png",
        "export/binary.js"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
